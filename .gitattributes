# Нормализация окончаний строк: LF в репозитории (удобно для Go и CI).
* text=auto eol=lf

*.go   text eol=lf diff=golang
go.mod text eol=lf
go.sum text eol=lf

*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf

Makefile text eol=lf

*.sh   text eol=lf

# Бинарники и архивы — не трогать как текст
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tgz  binary
